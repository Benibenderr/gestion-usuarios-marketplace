# Copiar este archivo como .env y ajustar los valores si hace falta.
# El archivo .env no se sube al repositorio (esta ignorado en .gitignore).

# Puerto donde escucha la API
PORT=3001

# Ruta del archivo SQLite (relativa a la carpeta backend/)
DB_STORAGE=./database.sqlite

# Origen permitido para CORS (el dev server de Vite)
CORS_ORIGIN=http://localhost:5173
